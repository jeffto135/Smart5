rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jeffto135@gmail.com' ||
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSubAdmin() {
      return isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
                          (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'sub-admin' ||
                           get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'subAdmin'));
    }

    // --- Vehicle Validation ---
    function isValidVehicle(data) {
      return (data.name is string || !data.keys().hasAll(['name'])) &&
             (data.plate is string || !data.keys().hasAll(['plate'])) &&
             (data.brand is string || !data.keys().hasAll(['brand'])) &&
             (data.model is string || !data.keys().hasAll(['model'])) &&
             (data.batteryCapacity is number || !data.keys().hasAll(['batteryCapacity'])) &&
             data.userId == request.auth.uid &&
             data.lastOdometer is number && data.lastOdometer >= 0 &&
             data.lastBatteryPercent is number && data.lastBatteryPercent >= 0 && data.lastBatteryPercent <= 100;
    }

    // --- Log Validation ---
    function isValidLog(data) {
      return data.vehicleId is string &&
             data.userId == request.auth.uid;
    }

    // --- UserProfile Validation ---
    function isValidProfile(data) {
      return (data.phoneNumber is string || !data.keys().hasAll(['phoneNumber'])) &&
             data.role in ['admin', 'sub-admin', 'member'] &&
             (data.email is string || !data.keys().hasAll(['email'])) &&
             (data.displayName is string || !data.keys().hasAll(['displayName'])) &&
             (data.photoURL is string || !data.keys().hasAll(['photoURL'])) &&
             (data.joinedAt is timestamp || !data.keys().hasAll(['joinedAt'])) &&
             (data.plate is string || !data.keys().hasAll(['plate'])) &&
             (data.selectedVehicleId is string || data.selectedVehicleId == null || !data.keys().hasAll(['selectedVehicleId'])) &&
             (data.lastMaintenanceKM is number || !data.keys().hasAll(['lastMaintenanceKM'])) &&
             (data.lastMaintenanceDate is timestamp || data.lastMaintenanceDate == null || !data.keys().hasAll(['lastMaintenanceDate'])) &&
             (data.licenseExpiryDate is timestamp || data.licenseExpiryDate == null || !data.keys().hasAll(['licenseExpiryDate'])) &&
             (data.insuranceExpiryDate is timestamp || data.insuranceExpiryDate == null || !data.keys().hasAll(['insuranceExpiryDate'])) &&
             data.updatedAt == request.time;
    }

    // --- Activity Validation ---
    function isValidActivity(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.date is string &&
             (data.eventStartDate is timestamp || data.eventStartDate == null || !data.keys().hasAll(['eventStartDate'])) &&
             (data.eventEndDate is timestamp || data.eventEndDate == null || !data.keys().hasAll(['eventEndDate'])) &&
             data.location is string &&
             data.limit is number && data.limit >= 1 &&
             (data.deadlineDate is string || data.deadlineDate == null || !data.keys().hasAll(['deadlineDate'])) &&
             data.participants is list &&
             data.status in ['open', 'closed'] &&
             data.createdAt is timestamp;
    }

    // --- Parking Lot Validation ---
    function isValidParkingLot(data) {
      return data.name is string &&
             data.region in ['港島', '九龍', '新界'] &&
             (data.address is string || !data.keys().hasAll(['address'])) &&
             data.lat is number &&
             data.lng is number &&
             (data.difficultyTag in ['輕易', '中等', '地獄', '不可能的任務'] || data.difficultyTag == null || !data.keys().hasAll(['difficultyTag'])) &&
             (data.adminNotes is string || !data.keys().hasAll(['adminNotes'])) &&
             (data.videoGuide is string || !data.keys().hasAll(['videoGuide'])) &&
             (data.hasDifficulty is bool || !data.keys().hasAll(['hasDifficulty'])) &&
             (data.hasCharging is bool || !data.keys().hasAll(['hasCharging'])) &&
             (data.maxKw is number || data.maxKw == null || !data.keys().hasAll(['maxKw'])) &&
             (data.totalGuns is number || data.totalGuns == null || !data.keys().hasAll(['totalGuns'])) &&
             (data.feeType is string || data.feeType == null || !data.keys().hasAll(['feeType'])) &&
             (data.tariffs is list || data.tariffs == null || !data.keys().hasAll(['tariffs'])) &&
             (data.gunGroups is list || data.gunGroups == null || !data.keys().hasAll(['gunGroups']));
    }

    // --- Registration Validation ---
    function isValidRegistration(data) {
      return data.eventId is string &&
             data.userId is string &&
             data.plateNumber is string &&
             data.qrCodeUsed is bool &&
             data.attended is bool &&
             (data.status is string || !data.keys().hasAll(['status'])) &&
             (data.cancelReason is string || !data.keys().hasAll(['cancelReason'])) &&
             (data.lockoutUntil is timestamp || !data.keys().hasAll(['lockoutUntil'])) &&
             (data.attendedAt is timestamp || !data.keys().hasAll(['attendedAt']));
    }

    // --- Poll Validation ---
    function isValidPoll(data) {
      return (data.title is string && data.title.size() <= 500) &&
             (data.question is string || !data.keys().hasAll(['question'])) &&
             data.options is list && data.options.size() >= 2 &&
             data.isMultiSelect is bool &&
             (data.maxChoices is number || !data.keys().hasAll(['maxChoices'])) &&
             data.votedUserIds is list &&
             (data.voters is list || !data.keys().hasAll(['voters'])) &&
             (data.endDate is string || !data.keys().hasAll(['endDate'])) &&
             data.createdAt is timestamp;
    }

    // --- GroupBuy Validation ---
    function isValidGroupBuy(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.description is string &&
             data.price is number && data.price >= 0 &&
             data.targetQuantity is number && data.targetQuantity >= 1 &&
             data.currentRegistrations is list &&
             data.status in ['active', 'closed', 'deleted'] &&
             (data.minQuantity is number || data.minQuantity == null || !data.keys().hasAll(['minQuantity'])) &&
             (data.maxQuantity is number || data.maxQuantity == null || !data.keys().hasAll(['maxQuantity'])) &&
             (data.endDate is timestamp || data.endDate == null || !data.keys().hasAll(['endDate'])) &&
             (data.imageUrl is string || !data.keys().hasAll(['imageUrl'])) &&
             data.createdAt is timestamp;
    }

    // --- ClubPerks Validation ---
    function isValidClubPerk(data) {
      return data.merchantName is string && data.merchantName.size() <= 200 &&
             data.category in ['汽車美容', '改裝配件', '汽車保險', '餐飲娛樂'] &&
             data.title is string && data.title.size() <= 200 &&
             data.discountDetail is string && data.discountDetail.size() <= 1000 &&
             data.contact is string && data.contact.size() <= 500 &&
             (data.expiryDate is string || !data.keys().hasAll(['expiryDate'])) &&
             (data.originalPrice is number || data.originalPrice == null || !data.keys().hasAll(['originalPrice'])) &&
             (data.discountPrice is number || data.discountPrice == null || !data.keys().hasAll(['discountPrice'])) &&
             (data.address is string || !data.keys().hasAll(['address'])) &&
             (data.googleMapsUrl is string || !data.keys().hasAll(['googleMapsUrl'])) &&
             data.createdAt is timestamp;
    }

    // --- FCMToken Validation ---
    function isValidFCMToken(data) {
      return data.token is string &&
             (data.deviceType is string || !data.keys().hasAll(['deviceType'])) &&
             (data.platform is string || !data.keys().hasAll(['platform'])) &&
             (data.userAgent is string || !data.keys().hasAll(['userAgent'])) &&
             data.lastUpdated is timestamp;
    }

    // --- Rules ---
    
    match /test/connection {
      allow read: if true;
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSubAdmin() && isValidActivity(incoming());
      allow update: if isSubAdmin() ||
                      (isSignedIn() && 
                       existing().status == 'open' &&
                       existing().participants.size() < existing().limit &&
                       !(request.auth.uid in existing().participants) &&
                       incoming().participants.hasAll(existing().participants) &&
                       incoming().participants.size() == existing().participants.size() + 1 &&
                       request.auth.uid in incoming().participants &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['participants']));
      allow delete: if isSubAdmin();
    }

    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isSubAdmin() && isValidPoll(incoming());
      allow update: if isSubAdmin() ||
                      (isSignedIn() &&
                       !(request.auth.uid in existing().get('votedUserIds', [])) &&
                       !(request.auth.uid in existing().get('voters', [])) &&
                       incoming().get('votedUserIds', []).hasAll(existing().get('votedUserIds', [])) &&
                       incoming().get('votedUserIds', []).size() == existing().get('votedUserIds', []).size() + 1 &&
                       request.auth.uid in incoming().get('votedUserIds', []) &&
                       incoming().get('voters', []).hasAll(existing().get('voters', [])) &&
                       incoming().get('voters', []).size() == existing().get('voters', []).size() + 1 &&
                       request.auth.uid in incoming().get('voters', []) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['options', 'votedUserIds', 'voters']));
      allow delete: if isSubAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow create: if isSignedIn(); 
      allow update: if isSignedIn() && (
        isSubAdmin() || (
          // Allow marking as read or dismissed if the message was intended for the user or everyone
          (existing().userId == request.auth.uid || existing().userId == 'all') &&
          incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'dismissedBy']) &&
          // Verify the user is adding their own UID to one of the arrays
          (request.auth.uid in incoming().get('readBy', []) || request.auth.uid in incoming().get('dismissedBy', [])) &&
          // Ensure they are not removing others (simple check for arrayUnion behavior)
          incoming().get('readBy', []).hasAll(existing().get('readBy', [])) &&
          incoming().get('dismissedBy', []).hasAll(existing().get('dismissedBy', []))
        )
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /system_pushes/{pushId} {
      allow read: if isSignedIn();
      allow create: if isSubAdmin();
      allow update, delete: if isSubAdmin();
    }

    match /userProfiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSubAdmin();
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if (isOwner(userId) || isSubAdmin()) && isValidProfile(incoming()) && 
                      (isSubAdmin() ? true : incoming().role == existing().role) &&
                      (isSubAdmin() ? true : incoming().joinedAt == existing().joinedAt) &&
                      (incoming().role == existing().role || isAdmin()) &&
                      (isAdmin() ? true : (
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'phoneNumber', 'displayName', 'photoURL', 'plate', 'selectedVehicleId', 'updatedAt',
                          'lastMaintenanceKM', 'lastMaintenanceDate', 'licenseExpiryDate', 'insuranceExpiryDate'
                        ]) || (
                          existing().status == 'pending_verification' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                        )
                      ));
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /userProfiles/{userId}/maintenance_logs/{logId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isSubAdmin());
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write, create, update: if isOwner(userId);
    }

    match /users/{userId}/maintenance_logs/{logId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isSubAdmin());
    }

    match /users/{userId}/tokens/{tokenId} {
      allow read: if isOwner(userId) || isSubAdmin();
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidFCMToken(incoming());
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow create: if isSignedIn() && 
                      isValidVehicle(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow read: if isOwner(existing().userId) || isSubAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isSubAdmin();

      allow update: if (isOwner(existing().userId) || isSubAdmin()) && 
                      isValidVehicle(incoming()) &&
                      // isSubAdmin can change userId if needed, but owners cannot
                      (isSubAdmin() ? true : incoming().userId == existing().userId) &&
                      incoming().createdAt == existing().createdAt;
      
      allow delete: if isOwner(existing().userId) || isSubAdmin();
    }

    match /vehicleLogs/{logId} {
      allow create: if isSignedIn() &&
                      isValidLog(incoming()) &&
                      // Ensure vehicle belongs to user (or sub-admin can create for anyone)
                      (isSubAdmin() || 
                       !exists(/databases/$(database)/documents/vehicles/$(incoming().vehicleId)) ||
                       get(/databases/$(database)/documents/vehicles/$(incoming().vehicleId)).data.userId == request.auth.uid);
      
      allow read: if isOwner(existing().userId) || isSubAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isSubAdmin();

      allow update: if (isOwner(existing().userId) || isSubAdmin()) &&
                      isValidLog(incoming()) &&
                      (isSubAdmin() ? true : (incoming().userId == existing().userId && incoming().vehicleId == existing().vehicleId));
      
      allow delete: if isOwner(existing().userId) || isSubAdmin();
    }

    match /parking_slots/{lotId} {
      allow read: if isSignedIn();
      allow create: if isSubAdmin() && isValidParkingLot(incoming());
      allow update: if (isSubAdmin() && isValidParkingLot(incoming())) ||
                       (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['chargingInfo']));
      allow delete: if isSubAdmin();
    }

    match /registrations/{regId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isSubAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidRegistration(incoming());
      allow update: if isSubAdmin() || (
                      isSignedIn() && resource.data.userId == request.auth.uid &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelReason', 'lockoutUntil', 'qrCodeUsed']) &&
                      incoming().status == 'cancelled'
                    );
      allow delete: if isSubAdmin();
    }

    match /groupBuys/{gbId} {
      allow read: if isSignedIn();
      allow create: if isSubAdmin() && isValidGroupBuy(incoming());
      allow update: if isSubAdmin() ||
                      (isSignedIn() &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['currentRegistrations']) &&
                       (existing().get('endDate', null) == null || existing().endDate > request.time));
      allow delete: if isSubAdmin();
    }

    match /clubPerks/{perkId} {
      allow read: if isSignedIn();
      allow create: if isSubAdmin() && isValidClubPerk(incoming());
      allow update: if isSubAdmin() && isValidClubPerk(incoming());
      allow delete: if isSubAdmin();
    }

    match /auditLogs/{logId} {
      // 🔒 只有最高管理員 admin 才能讀取日誌，任何人（包括 subAdmin）都絕對不能修改或刪除日誌
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
